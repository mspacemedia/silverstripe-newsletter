<tr<% if $HideOnMobile %> class="hide-mobile"<% end_if %>>
    <td class="$BlockClass" style="$InlineStyle">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td style="border-top:{$LineThickness}px solid $EffectiveLineColor;font-size:0;line-height:0;height:0;mso-line-height-rule:exactly;">&nbsp;</td>
            </tr>
        </table>
    </td>
</tr>
