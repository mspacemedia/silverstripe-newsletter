            &nbsp;&middot;&nbsp;
            <a href="$UnsubscribeLink.ATT" target="_blank" style="color:$EffectiveMutedColor;text-decoration:underline;"><%t MSpaceMedia\Newsletter\Email\Blocks\FooterBlock.UNSUBSCRIBE 'Unsubscribe' %></a>
        </p>
    </td>
</tr>
